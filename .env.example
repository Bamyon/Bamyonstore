# Everything has a working default (see src/lib/firebase.ts and src/config/brand.ts). Override in Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://bamyon.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PAYSTACK_KEY=
# false = wallet and orders run in the browser (testing). true = use the deployed Cloud Functions (go live).
NEXT_PUBLIC_USE_FUNCTIONS=false
